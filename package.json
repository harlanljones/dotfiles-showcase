{
  "name": "dotfiles-showcase",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run dev.ts",
    "dev:client": "vite",
    "dev:server": "bun run server/index.ts",
    "build": "vite build",
    "start": "bun run server/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "fallbacks:refresh": "bun run scripts/refresh-fallbacks.ts",
    "fallbacks:check": "bun run scripts/refresh-fallbacks.ts --check",
    "wrangler:types": "wrangler types",
    "wrangler:dev": "wrangler dev --local",
    "wrangler:deploy": "wrangler deploy"
  },
  "dependencies": {
    "ansi-to-html": "^0.7.2",
    "hono": "^4.9.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/bun": "latest",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "axe-core": "^4.13.0",
    "happy-dom": "^20.11.13",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "wrangler": "^4.126.0"
  }
}
